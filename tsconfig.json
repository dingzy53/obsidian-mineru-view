{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"importHelpers": true,
		"resolveJsonModule": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
