{
	"name": "mineru-view",
	"version": "0.1.0",
	"description": "Obsidian desktop plugin: show MinerU layout results (block boxes, types, reading order) on PDFs.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:review": "eslint --config eslint.review.config.mjs --max-warnings 0 .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:unit": "vitest run",
		"check:mobile": "node scripts/check-mobile-compat.mjs",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"test:e2e:fast": "OBSIDIAN_VERSIONS=latest/latest OBSIDIAN_E2E_TARGET=desktop wdio run ./wdio.conf.mts"
	},
	"keywords": [
		"obsidian",
		"mineru",
		"pdf"
	],
	"author": "Ding Zheng Yuan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dingzy53/obsidian-mineru-view.git"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.10.2",
		"@wdio/cli": "^9.33.1",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.33.1",
		"@wdio/mocha-framework": "^9.33.1",
		"@wdio/spec-reporter": "^9.33.1",
		"esbuild": "^0.24.2",
		"eslint": "^9.17.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"mocha": "^10.8.2",
		"obsidian": "^1.14.4",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.1",
		"vitest": "^2.1.8",
		"wdio-obsidian-reporter": "^3.5.0",
		"wdio-obsidian-service": "^3.5.0"
	}
}
