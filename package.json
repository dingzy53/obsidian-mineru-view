{
	"name": "mineru-view",
	"version": "0.1.0",
	"description": "Obsidian desktop plugin: show MinerU layout results (block boxes, types, reading order) on PDFs.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:review": "eslint --config eslint.review.config.mjs --max-warnings 0 .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"mineru",
		"pdf"
	],
	"author": "Ding Zheng Yuan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dingzy53/obsidian-mineru-view.git"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"esbuild": "^0.24.2",
		"eslint": "^9.17.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "^1.14.4",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.1",
		"vitest": "^2.1.8"
	}
}
